<Project>
  <PropertyGroup>
    <!-- En unidades de red las consultas Git/SourceLink fallan; no son necesarias. -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>CadMepRevit</Company>
    <Product>CAD MEP para Revit</Product>
    <!-- Propiedad intelectual: titular y licencia (LICENSE en la raíz del repositorio). Quedan en los metadatos de cada DLL y del instalador. -->
    <Authors>Victor Hipp Murcia</Authors>
    <Copyright>Copyright © 2026 Victor Hipp Murcia. Licencia MIT.</Copyright>
  </PropertyGroup>
  <!-- Revit 2023 y 2024 (.NET Framework 4.8): el C# moderno necesita tipos de apoyo (PolySharp los genera en compilación)
       y algunas bibliotecas que .NET 8 trae de serie. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48' And '$(MSBuildProjectName)' != 'InstaladorCadMep'">
    <!-- Los avisos de nulos ya se comprueban en las compilaciones .NET 8/10; .NET Framework no anota sus métodos (IsNullOrEmpty…). -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8762;CS8767</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' And '$(MSBuildProjectName)' != 'InstaladorCadMep'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <!-- Miembros de .NET 8 que faltan en .NET Framework 4.8 (src\CadMepRevit.Core\Compat\NetFrameworkCompat.cs). -->
    <Using Include="CadMepRevit.Compat" />
  </ItemGroup>
</Project>
