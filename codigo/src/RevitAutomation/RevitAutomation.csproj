<Project Sdk="Microsoft.NET.Sdk">
  <!-- RevitAutomation: el complemento que crea la pestaña única «RevitAutomation» para Revit 2023, 2024, 2025, 2026 y 2027.
       Contiene las herramientas de exportación, etiquetado, salas técnicas, instalaciones, planos y región, y carga el
       motor CAD-REV (CadMepRevit.dll) para sus botones. Versiones y API en ..\Revit.props. -->
  <Import Project="..\Revit.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>RevitAutomation.Addin</RootNamespace>
    <AssemblyName>RevitAutomation</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF quita este using implícito del SDK; las herramientas lo usan. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CadMepRevit\CadMepRevit.csproj" />
  </ItemGroup>
</Project>
